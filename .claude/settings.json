{
  "permissions": {
    "deny": [
      "Read(./node_modules/**)",
      "Read(./worker/node_modules/**)",
      "Read(./dist/**)",
      "Read(./.wrangler/**)",
      "Read(./worker/.wrangler/**)",
      "Read(./.dev.vars)",
      "Read(./worker/.dev.vars)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/filter-test-output.sh"
          }
        ]
      }
    ]
  }
}
